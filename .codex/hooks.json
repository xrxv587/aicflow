{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/node_modules/aicflow/dist/hook.js\" sessionstart --client codex"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/node_modules/aicflow/dist/hook.js\" userpromptsubmit --client codex"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|ApplyPatch|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/node_modules/aicflow/dist/hook.js\" pretooluse --client codex"
          }
        ]
      }
    ]
  }
}
